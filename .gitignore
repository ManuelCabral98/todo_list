# OS generated files or editor configurations
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# BACKEND: RAILS APPLICATION CONFIGURATION (todo_backend/)
# Ignore local bundler configuration
todo_backend/.bundle

# Ignore local environment variables containing secrets
todo_backend/.env*

# Ignore logfiles and tempfiles generated by the Rails server
todo_backend/log/*
todo_backend/tmp/*
!todo_backend/log/.keep
!todo_backend/tmp/.keep

# Ignore active server pidfiles
todo_backend/tmp/pids/*
!todo_backend/tmp/pids/
!todo_backend/tmp/pids/.keep

# Ignore development SQLite database and uploaded files (Active Storage)
todo_backend/storage/*
!todo_backend/storage/.keep
todo_backend/tmp/storage/*
!todo_backend/tmp/storage/
!todo_backend/tmp/storage/.keep

# Ignore compiled assets in development environment
todo_backend/public/assets
todo_backend/config/*.key
todo_backend/config/master.key

# FRONTEND: VITE & REACT CONFIGURATION (todo_frontend/)

todo_frontend/node_modules/
node_modules/

# Ignore local production build outputs
todo_frontend/dist/
todo_frontend/dist-ssr/
todo_frontend/*.local

# Ignore npm debug log files
todo_frontend/npm-debug.log*
todo_frontend/yarn-debug.log*
todo_frontend/yarn-error.log*
todo_frontend/pnpm-debug.log*

# Ignore local environment configuration files
todo_frontend/.env.local
todo_frontend/.env.development.local
todo_frontend/.env.production.local
todo_frontend/.env.test.local

# Ignore TypeScript declaration caches (if applicable in the future)
todo_frontend/.typescript-declarations/

# Ignore .env files
.env

# Ignore .claude directory
.claude